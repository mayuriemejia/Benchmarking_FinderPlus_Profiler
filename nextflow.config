// (•˕ •マ.ᐟ
// AMR Benchmark — nextflow.config

manifest {
    name            = 'amr-benchmark'
    author          = 'Mayurie Mejía | Sequentia Biotech'
    description     = 'AMRFinderPlus + AMRProfiler benchmark con evaluación vs truthset'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}

params {
    // ── Input ────────────────────────────────────────────────────────────────
    samplesheet = null
    truthset    = null

    // ── Pipeline AMRFinderPlus existente ─────────────────────────────────────
    amrfinder_nf_dir = "/media/sequentia/isilon/students/visitor6/monkey_d_benchmark/amrfinderplus_nf"

    // ── DB AMRProfiler ───────────────────────────────────────────────────────
    amrp_db = "/media/sequentia/isilon/students/visitor6/monkey_d_benchmark/amrprofiler_nf/amrprofiler_db/amrprofiler-main"

    // ── Output ───────────────────────────────────────────────────────────────
    outdir = "benchmark_results"

    // ── Recursos ─────────────────────────────────────────────────────────────
    threads = 8
    mem_gb  = 16

    // ── Imágenes Docker ──────────────────────────────────────────────────────
    img_sra         = 'staphb/sratoolkit:latest'
    img_fastp       = 'staphb/fastp:latest'
    img_spades      = 'staphb/spades:latest'
    img_prokka      = 'staphb/prokka:latest'
    img_amr         = 'staphb/ncbi-amrfinderplus:latest'
    img_amrprofiler = 'amrprofiler:1.0.0'
    img_python      = 'amr-python-report:3.11'
}

profiles {
    docker {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g) -v /media/sequentia/isilon:/media/sequentia/isilon'
        singularity.enabled = false
    }
    test {
        params.threads = 2
        params.mem_gb  = 4
    }
}

process {
    errorStrategy = 'retry'
    maxRetries    = 2

    withName: 'FASTP_QC' {
        cpus   = params.threads
        memory = '4 GB'
        time   = '2h'
    }
    withName: 'SPADES_ASSEMBLY' {
        cpus   = params.threads
        memory = "${params.mem_gb} GB"
        time   = '12h'
    }
    withName: 'PROKKA_ANNOTATION' {
        cpus   = params.threads
        memory = '8 GB'
        time   = '4h'
    }
    withName: 'AMRFINDER_PLUS' {
        cpus   = params.threads
        memory = '8 GB'
        time   = '4h'
    }
    withName: 'AMRPROFILER' {
        cpus   = params.threads
        memory = "${params.mem_gb} GB"
        time   = '6h'
    }
    withName: 'EVAL_BENCHMARK' {
        cpus   = 1
        memory = '2 GB'
        time   = '1h'
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv";     overwrite = true }
